NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secret key (service_role). Used by the hidden /guest-list page,
# its server actions, and /api/rsvp to read the private guest list and detect
# duplicate RSVPs. NEVER expose this to the browser — no NEXT_PUBLIC_ prefix.
# Find it in the Supabase dashboard under Project Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
