NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secret key (service_role). Used by authorized management pages,
# their server actions, and /api/rsvp to read the private guest list and detect
# duplicate RSVPs. NEVER expose this to the browser — no NEXT_PUBLIC_ prefix.
# Find it in the Supabase dashboard under Project Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Comma-separated, verified Supabase Auth email addresses permitted to manage
# guests and tasks. Empty/missing denies all host access. No NEXT_PUBLIC_ prefix.
# Create the host account in Supabase Auth and set its password before signing in.
ADMIN_EMAILS=host@example.com

# Optional. Salt used to hash submitter IPs for RSVP rate limiting, so the
# database never stores a raw IP address. Any long random string works; if it
# is unset the service-role key is used as the salt instead. Changing it resets
# everyone's rate-limit history.
RSVP_IP_SALT=any-long-random-string
